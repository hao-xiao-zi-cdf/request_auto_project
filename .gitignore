# ================= ======= =================
# Python 相关
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg

# ================= ======= =================
# PyCharm / IDE 相关 (重点)
# ==========================================
# PyCharm 项目配置目录 (非常重要，必须忽略)
.idea/
*.iml
*.ipr
*.iws

# VS Code (以防混用)
.vscode/

# 其他编辑器
*.swp
*.swo
*~

# ================= ======= =================
# 测试框架与报告相关
# ==========================================
# pytest 缓存
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# 测试报告输出目录 (保留目录结构，忽略内容)
reports/html/*
reports/allure/*
reports/logs/*
reports/screenshots/*
!reports/**/.gitkeep

# ================= ======= =================
# 操作系统相关
# ==========================================
# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# ================= ======= =================
# 敏感信息与本地配置
# ==========================================
# 环境变量文件 (包含密码、Token等敏感信息)
.env
.env.local

# 本地配置文件覆盖
config.local.yaml
*.local.yaml

# 日志文件
*.log
